#!/bin/bash
# Houston container bootstrap. Replaces the deprecated gce-container-declaration agent.
# Runs on every boot; the stop/rm makes it idempotent across reboots and metadata updates.
set -euo pipefail

CONTAINER_NAME="houston"

docker stop  "$CONTAINER_NAME" 2>/dev/null || true
docker rm    "$CONTAINER_NAME" 2>/dev/null || true

# Image is public on Docker Hub, so no registry auth is required.
docker run --detach \
  --name="$CONTAINER_NAME" \
  --restart=always \
  --publish=80:80 \
  --publish=443:443 \
  --volume=/var/run/docker.sock:/var/run/docker.sock \
  --volume=/home/houston:/data \
  --env=HOUSTON_PASSWORD='${houston_password}' \
  --env=HOUSTON_PORT=80 \
  --env=TLS_HOST='${tls_host}' \
  "datasparq/houston-redis:${houston_version}" \
  api
